config mm_watchdog 'main'
	option enabled '1'
	option interface 'wwan'
	option modem 'auto'

	option check_interval '5'
	option ping_timeout '2'
	list ping_target '1.1.1.1'
	list ping_target '8.8.8.8'

	option modemmanager_fail_limit '3'
	option connected_fail_limit '3'
	option registered_fail_limit '3'

	option searching_recovery_after '180'
	option searching_recovery_cooldown '600'
	option temporary_state_timeout '120'
	option enabled_state_timeout '60'
	option action_grace '20'

	option mm_restart_cooldown '120'
	option radio_cycle_cooldown '120'
	option modem_reset_cooldown '600'
	option hardware_reset_gpio '515'

	option webhook_enabled '0'
	option webhook_url ''
	option webhook_timeout '5'
	option webhook_retry_interval '60'
	option webhook_queue_limit '20'
	option report_startup '1'
	option report_recovery '1'
	option report_errors '1'
