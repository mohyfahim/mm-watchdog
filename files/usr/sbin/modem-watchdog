#!/bin/sh

#
# Podbox ModemManager watchdog
#
# Recovery order:
#
#   1. ifdown/ifup
#   2. restart ModemManager
#   3. disable/enable modem radio
#   4. modem reset
#
# Diagnostics are sent directly to:
#
#   https://api.podbox.plus/logs
#
# Expected API format:
#
# {
#   "name": "system",
#   "content": {
#       ...
#   },
#   "type": "mm-watch-dog"
# }
#
# Designed for OpenWrt / BusyBox ash.
#

. /lib/functions.sh
. /usr/share/libubox/jshn.sh
. /usr/share/ModemManager/modemmanager.common

TAG="modem-watchdog"

###############################################################################
# Configuration
###############################################################################

load_watchdog_config() {
	config_load mm-watchdog

	config_get_bool ENABLED main enabled 1

	config_get NETIF main interface "wwan"

	config_get_bool API_ENABLED main api_enabled 1
	config_get API_URL main api_url \
		"https://api.podbox.plus/logs"

	config_get API_NAME main api_name \
		"system"

	config_get API_TYPE main api_type \
		"mm-watch-dog"

	# config_get API_CONNECT_TIMEOUT main api_connect_timeout 2
	# config_get API_MAX_TIME main api_max_time 5
	config_get API_TIMEOUT main api_timeout 5

	config_get CHECK_INTERVAL main check_interval 5

	#
	# 3 failures * 5 seconds = about 15 seconds.
	#
	config_get CONNECTED_FAIL_LIMIT \
		main connected_fail_limit 3

	config_get REGISTERED_FAIL_LIMIT \
		main registered_fail_limit 3

	#
	# Searching is normal in low-coverage areas.
	# Don't touch the modem aggressively while it searches.
	#
	config_get SEARCHING_RECOVERY_AFTER \
		main searching_recovery_after 180

	config_get SEARCHING_RECOVERY_COOLDOWN \
		main searching_recovery_cooldown 600

	#
	# Do not repeatedly hard reset the modem.
	#
	config_get MODEM_RESET_COOLDOWN \
		main modem_reset_cooldown 600

	config_get MM_RESTART_COOLDOWN \
		main mm_restart_cooldown 120

	#
	# Maximum time modem may remain in transitional states.
	#
	config_get TEMP_STATE_TIMEOUT \
		main temporary_state_timeout 120

	config_get ENABLED_STATE_TIMEOUT \
		main enabled_state_timeout 60

	#
	# Wait after recovery operations before evaluating again.
	#
	config_get ACTION_GRACE \
		main action_grace 20

	config_get PING_TIMEOUT \
		main ping_timeout 2

	config_get PING_TARGETS \
		main ping_targets "1.1.1.1 8.8.8.8"

	config_get_bool REPORT_RECOVERY \
		main report_recovery 1

	config_get_bool REPORT_ERRORS \
		main report_errors 1

	config_get_bool REPORT_STARTUP \
		main report_startup 1

	#
	# Maximum size of individual diagnostic fields.
	#
	config_get MAX_DIAG_BYTES \
		main max_diag_bytes 8000

	config_get MODEM_LOG_LINES \
		main modem_log_lines 60

	config_get KERNEL_LOG_LINES \
		main kernel_log_lines 40
}

load_watchdog_config

[ "$ENABLED" -eq 1 ] || exit 0

###############################################################################
# Runtime state
###############################################################################

bad_count=0
mm_failure_count=0

#
# Recovery level:
#
#   0 = nothing attempted
#   1 = soft reconnect attempted
#   2 = ModemManager restart attempted
#   3 = radio cycle attempted
#   4 = modem reset attempted
#
recovery_level=0

last_state=""
state_since="$(date +%s)"

last_mm_restart=0
last_modem_reset=0
last_search_recovery=0

incident_id=""
incident_started=0

###############################################################################
# Logging
###############################################################################

log() {
	logger \
		-p daemon.info \
		-t "$TAG" \
		"$*"
}

log_warning() {
	logger \
		-p daemon.warning \
		-t "$TAG" \
		"$*"
}

###############################################################################
# Generic helpers
###############################################################################

now() {
	date +%s
}

truncate_output() {
	head -c "$MAX_DIAG_BYTES"
}

ensure_incident() {
	[ -n "$incident_id" ] && return

	incident_started="$(now)"
	incident_id="${incident_started}-$$"

	log "incident-start id=$incident_id"
}

clear_incident() {
	incident_id=""
	incident_started=0
}

set_recovery_level_min() {
	local minimum="$1"

	[ "$recovery_level" -ge "$minimum" ] ||
		recovery_level="$minimum"
}

###############################################################################
# Modem helpers
###############################################################################

get_modem_status() {
	mmcli \
		--timeout 10 \
		--modem any \
		--output-keyvalue \
		2>/dev/null
}

get_bearer_path() {
	local modem_status="$1"

	[ -n "$modem_status" ] || return 1

	modemmanager_get_field \
		"$modem_status" \
		'modem.generic.bearers.value\[1\]'
}

get_bearer_status() {
	local bearer_path="$1"

	[ -n "$bearer_path" ] || return 1

	mmcli \
		--timeout 10 \
		--bearer "$bearer_path" \
		--output-keyvalue \
		2>/dev/null
}

get_bearer_iface() {
	local bearer_status="$1"

	[ -n "$bearer_status" ] || return 1

	modemmanager_get_field \
		"$bearer_status" \
		"bearer.status.interface"
}

###############################################################################
# Actual Internet connectivity check
###############################################################################

internet_ok() {
	local iface="$1"
	local target

	[ -n "$iface" ] || return 1

	ip link show dev "$iface" \
		>/dev/null 2>&1 ||
		return 1

	for target in $PING_TARGETS; do

		if ping \
			-I "$iface" \
			-c 1 \
			-W "$PING_TIMEOUT" \
			"$target" \
			>/dev/null 2>&1; then
			return 0
		fi

	done

	return 1
}

###############################################################################
# Wait for ModemManager
###############################################################################

wait_for_modemmanager() {
	local count=0

	while [ "$count" -lt 40 ]; do

		if mmcli \
			--timeout 5 \
			-L \
			>/dev/null 2>&1 &&
			mmcli \
				--timeout 5 \
				-m any \
				-K \
				>/dev/null 2>&1; then
			return 0
		fi

		count=$((count + 1))

		sleep 1
	done

	return 1
}

###############################################################################
# Diagnostic collectors
###############################################################################

collect_modem_summary() {
	mmcli \
		--timeout 10 \
		-m any \
		-K \
		2>&1 |
		grep -E \
			'generic.state|generic.signal-quality|generic.access-technologies|generic.bearers|3gpp.registration-state|3gpp.operator-name|3gpp.operator-code|3gpp.packet-service-state' |
		truncate_output
}

collect_bearer_summary() {
	local bearer="$1"

	[ -n "$bearer" ] || return

	mmcli \
		--timeout 10 \
		-b "$bearer" \
		-K \
		2>&1 |
		truncate_output
}

collect_recent_modem_logs() {
	logread \
		2>/dev/null |
		grep -E \
			'ModemManager|modemmanager|modem-watchdog|netifd|qmi|QMI|cdc-wdm|wwan' |
		tail -n "$MODEM_LOG_LINES" |
		truncate_output
}

collect_recent_kernel_logs() {
	dmesg \
		2>/dev/null |
		grep -E \
			'qmi|QMI|cdc-wdm|wwan|usb|USB|option|ttyUSB' |
		tail -n "$KERNEL_LOG_LINES" |
		truncate_output
}

