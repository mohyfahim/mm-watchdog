report_event() {
	local severity="$1"
	local event="$2"
	local reason="$3"
	local action="$4"

	local modem_status=""
	local state="unknown"
	local registration="unknown"
	local signal="unknown"
	local access_tech="unknown"
	local packet_service="unknown"

	local bearer_path=""
	local bearer_status=""
	local bearer_iface=""
	local bearer_connected="unknown"

	local internet="false"

	local hostname
	local timestamp
	local uptime_seconds
	local incident_age=0

	local ifstatus_data
	local addr_data
	local route_data
	local rule_data

	local modem_summary
	local bearer_summary
	local modem_logs
	local kernel_logs

	local json_file

	[ "$API_ENABLED" -eq 1 ] ||
		return 0

	#######################################################################
	# Current ModemManager state
	#######################################################################

	modem_status="$(get_modem_status)"

	if [ -n "$modem_status" ]; then

		state="$(
			modemmanager_get_field \
				"$modem_status" \
				"modem.generic.state"
		)"

		registration="$(
			modemmanager_get_field \
				"$modem_status" \
				"modem.3gpp.registration-state"
		)"

		signal="$(
			modemmanager_get_field \
				"$modem_status" \
				"modem.generic.signal-quality.value"
		)"

		access_tech="$(
			modemmanager_get_field \
				"$modem_status" \
				"modem.generic.access-technologies"
		)"

		packet_service="$(
			modemmanager_get_field \
				"$modem_status" \
				"modem.3gpp.packet-service-state"
		)"

		bearer_path="$(
			get_bearer_path \
				"$modem_status"
		)"

	fi

	[ -n "$state" ] ||
		state="unknown"

	[ -n "$registration" ] ||
		registration="unknown"

	[ -n "$signal" ] ||
		signal="unknown"

	[ -n "$access_tech" ] ||
		access_tech="unknown"

	[ -n "$packet_service" ] ||
		packet_service="unknown"

	#######################################################################
	# Bearer state
	#######################################################################

	if [ -n "$bearer_path" ]; then

		bearer_status="$(
			get_bearer_status \
				"$bearer_path"
		)"

		if [ -n "$bearer_status" ]; then

			bearer_iface="$(
				get_bearer_iface \
					"$bearer_status"
			)"

			bearer_connected="$(
				modemmanager_get_field \
					"$bearer_status" \
					"bearer.status.connected"
			)"

		fi

	fi

	[ -n "$bearer_connected" ] ||
		bearer_connected="unknown"

	#######################################################################
	# Internet test
	#######################################################################

	if [ -n "$bearer_iface" ] &&
		internet_ok "$bearer_iface"; then
		internet="true"
	fi

	#######################################################################
	# General information
	#######################################################################

	hostname="$(
		uci -q get system.@system[0].hostname
	)"

	[ -n "$hostname" ] ||
		hostname="$(hostname)"

	timestamp="$(
		date -u '+%Y-%m-%dT%H:%M:%SZ'
	)"

	uptime_seconds="$(
		cut -d. -f1 /proc/uptime \
			2>/dev/null
	)"

	[ -n "$uptime_seconds" ] ||
		uptime_seconds="unknown"

	if [ "$incident_started" -gt 0 ]; then

		incident_age=$((\
			$(now) - incident_started))

	fi

	#######################################################################
	# Linux / netifd diagnostics
	#######################################################################

	# ifstatus_data="$(
	# 	ifstatus "$NETIF" \
	# 		2>&1 |
	# 		truncate_output
	# )"

	if [ -n "$bearer_iface" ]; then

		addr_data="$(
			ip addr show \
				dev "$bearer_iface" \
				2>&1 |
				truncate_output
		)"

	else

		addr_data="bearer interface unavailable"

	fi

	route_data="$(
		ip route show \
			2>&1 |
			truncate_output
	)"

	rule_data="$(
		ip rule show \
			2>&1 |
			truncate_output
	)"

	#######################################################################
	# Modem / kernel logs
	#######################################################################

	# modem_summary="$(
	# 	collect_modem_summary
	# )"

	# bearer_summary="$(
	# 	collect_bearer_summary \
	# 		"$bearer_path"
	# )"

	# modem_logs="$(
	# 	collect_recent_modem_logs
	# )"

	# kernel_logs="$(
	# 	collect_recent_kernel_logs
	# )"

	#######################################################################
	# Build JSON
	#######################################################################

	json_init

	json_add_string \
		"name" \
		"$API_NAME"

	json_add_object \
		"content"

	json_add_string \
		"deviceDate" \
		"$timestamp"

	json_add_string \
		"hostname" \
		"$hostname"

	json_add_string \
		"uptimeSeconds" \
		"$uptime_seconds"

	json_add_string \
		"severity" \
		"$severity"

	json_add_string \
		"event" \
		"$event"

	json_add_string \
		"reason" \
		"$reason"

	json_add_string \
		"action" \
		"$action"

	json_add_string \
		"incidentId" \
		"${incident_id:-none}"

	json_add_string \
		"incident_age_seconds" \
		"$incident_age"

	json_add_string \
		"recoveryLevel" \
		"$recovery_level"

	json_add_string \
		"mmState" \
		"$state"

	json_add_string \
		"registration" \
		"$registration"

	json_add_string \
		"signal_quality" \
		"$signal"

	json_add_string \
		"accessTech" \
		"$access_tech"

	json_add_string \
		"packetService" \
		"$packet_service"

	json_add_string \
		"bearer_path" \
		"${bearer_path:-none}"

	json_add_string \
		"bearerInterface" \
		"${bearer_iface:-none}"

	json_add_string \
		"bearerconnected" \
		"$bearer_connected"

	json_add_string \
		"internetReachable" \
		"$internet"

	# json_add_string \
	# 	"ifstatus" \
	# 	"$ifstatus_data"

	# json_add_string \
	# 	"ip_addr" \
	# 	"$addr_data"

	# json_add_string \
	# 	"ip_route" \
	# 	"$route_data"

	# json_add_string \
	# 	"ip_rule" \
	# 	"$rule_data"

	# json_add_string \
	# 	"modem_summary" \
	# 	"$modem_summary"

	# json_add_string \
	# 	"bearer_summary" \
	# 	"$bearer_summary"

	# json_add_string \
	# 	"recent_modem_logs" \
	# 	"$modem_logs"

	# json_add_string \
	# 	"recent_kernel_logs" \
	# 	"$kernel_logs"

	json_close_object

	json_add_string \
		"type" \
		"$API_TYPE"

	#######################################################################
	# Write temporary JSON file.
	#
	# This is NOT a queue. The file only exists for the duration
	# of this HTTP request because OpenWrt uclient-fetch wget's
	# --post-file option expects a real file.
	#######################################################################

	json_file="/tmp/mm-watchdog-api-$$.json"

	if ! json_dump >"$json_file"; then

		logger \
			-p daemon.warning \
			-t "$TAG" \
			"failed to create diagnostic JSON event=$event"

		rm -f "$json_file"

		return 1

	fi

	###############################################################################
	# Send diagnostic JSON to local API.
	#
	# OpenWrt uclient-fetch incorrectly considers some valid 2xx responses,
	# including HTTP 201 Created, to be errors.
	#
	# Therefore:
	#
	#   exit 0                     -> success
	#   exit 8 + "HTTP error 2xx" -> also success
	#   everything else           -> failure
	###############################################################################

	local wget_output
	local wget_rc

	wget_output="$(
		/bin/uclient-fetch \
			-4 \
			--no-proxy \
			-O /dev/null \
			--timeout="$API_TIMEOUT" \
			--header='Content-Type: application/json' \
			--post-file="$json_file" \
			"$API_URL" \
			2>&1
	)"

	wget_rc=$?

	#
	# Normal uclient-fetch success.
	#
	if [ "$wget_rc" -eq 0 ]; then

		rm -f "$json_file"

		return 0

	fi

	#
	# uclient-fetch treats some valid HTTP 2xx statuses as errors.
	#
	# Examples:
	#
	#   HTTP error 201
	#   HTTP error 202
	#   HTTP error 205
	#
	# All HTTP 2xx responses are considered successful by this API client.
	#
	if [ "$wget_rc" -eq 8 ] &&
		printf '%s\n' "$wget_output" |
		grep -Eq 'HTTP error 2[0-9][0-9]([^0-9]|$)'; then

		rm -f "$json_file"

		return 0

	fi

	#
	# Real failure.
	#
	logger \
		-p daemon.warning \
		-t "$TAG" \
		"failed to send diagnostic event=$event rc=$wget_rc response='$wget_output'"

	rm -f "$json_file"

	return 1

}

###############################################################################
# Error logger
#
# Errors go both to logread and the local API.
###############################################################################

log_error() {
	local message="$*"

	logger \
		-p daemon.err \
		-t "$TAG" \
		"$message"

	if [ "$REPORT_ERRORS" -eq 1 ]; then

		report_event \
			"error" \
			"watchdog-error" \
			"$message" \
			"none"

	fi
}

###############################################################################
# Recovery logger
###############################################################################

log_recovery() {
	local event="$1"
	local reason="$2"
	local action="$3"

	logger \
		-p daemon.warning \
		-t "$TAG" \
		"event=$event recovery=$action reason=$reason level=$recovery_level incident=${incident_id:-none}"

	if [ "$REPORT_RECOVERY" -eq 1 ]; then

		report_event \
			"warning" \
			"$event" \
			"$reason" \
			"$action"

	fi
}

###############################################################################
# Recovery level 1
#
# Recreate the bearer through netifd.
#
# IMPORTANT:
#
# The OpenWrt modemmanager interface should have:
#
#       option disable_modem '0'
#
# Otherwise ifdown may also disable the radio.
###############################################################################

soft_reconnect() {
	local reason="$1"

	ensure_incident

	log_recovery \
		"$reason" \
		"$reason" \
		"soft-reconnect"

	ifdown "$NETIF" \
		>/dev/null 2>&1

	sleep 2

	if ! ifup "$NETIF" \
		>/dev/null 2>&1; then

		log_error \
			"ifup failed during soft reconnect reason=$reason"

		return 1

	fi

	return 0
}

###############################################################################
# Recovery level 2
###############################################################################

restart_modemmanager() {
	local reason="$1"

	ensure_incident

	log_recovery \
		"$reason" \
		"$reason" \
		"restart-modemmanager"

	ifdown "$NETIF" \
		>/dev/null 2>&1

	if ! /etc/init.d/modemmanager restart \
		>/dev/null 2>&1; then

		log_error \
			"failed to restart ModemManager reason=$reason"

		return 1

	fi

	if ! wait_for_modemmanager; then

		log_error \
			"ModemManager unavailable after restart reason=$reason"

		return 1

	fi

	log \
		"ModemManager available again"

	if ! ifup "$NETIF" \
		>/dev/null 2>&1; then

		log_error \
			"ifup failed after ModemManager restart reason=$reason"

		return 1

	fi

	return 0
}

###############################################################################
# Recovery level 3
###############################################################################

radio_cycle() {
	local reason="$1"

	ensure_incident

	log_recovery \
		"$reason" \
		"$reason" \
		"radio-cycle"

	ifdown "$NETIF" \
		>/dev/null 2>&1

	#
	# Ignore simple-disconnect failure because there may
	# already be no active bearer.
	#
	mmcli \
		--timeout 20 \
		-m any \
		--simple-disconnect \
		>/dev/null 2>&1

	if ! mmcli \
		--timeout 30 \
		-m any \
		--disable \
		>/dev/null 2>&1; then

		log_warning \
			"modem disable failed during radio cycle reason=$reason"

	fi

	sleep 3

	if ! mmcli \
		--timeout 60 \
		-m any \
		--enable \
		>/dev/null 2>&1; then

		log_error \
			"failed to enable modem after radio cycle reason=$reason"

		return 1

	fi

	log \
		"radio enabled again"

	sleep 3

	if ! ifup "$NETIF" \
		>/dev/null 2>&1; then

		log_error \
			"ifup failed after radio cycle reason=$reason"

		return 1

	fi

	return 0
}

###############################################################################
# Recovery level 4
###############################################################################

reset_modem() {
	local reason="$1"

	ensure_incident

	log_recovery \
		"$reason" \
		"$reason" \
		"modem-reset"

	ifdown "$NETIF" \
		>/dev/null 2>&1

	if ! mmcli \
		--timeout 30 \
		-m any \
		--reset \
		>/dev/null 2>&1; then

		log_error \
			"mmcli modem reset command failed reason=$reason"

	fi

	#
	# The ModemManager modem object may disappear and return
	# using a different modem index.
	#
	sleep 10

	if ! wait_for_modemmanager; then

		log_error \
			"modem did not reappear after modem reset"

		if ! /etc/init.d/modemmanager restart \
			>/dev/null 2>&1; then

			log_error \
				"failed to restart ModemManager after modem reset"

			return 1

		fi

		if ! wait_for_modemmanager; then

			log_error \
				"modem unavailable even after ModemManager restart"

			return 1

		fi

	fi

	if ! ifup "$NETIF" \
		>/dev/null 2>&1; then

		log_error \
			"ifup failed after modem reset reason=$reason"

		return 1

	fi

	return 0
}

###############################################################################
# Escalating recovery state machine
###############################################################################

recover_connection() {
	local reason="$1"
	local current

	ensure_incident

	case "$recovery_level" in

	0)

		soft_reconnect \
			"$reason"

		recovery_level=1

		;;

	1)

		restart_modemmanager \
			"$reason"

		last_mm_restart="$(now)"

		recovery_level=2

		;;

	2)

		radio_cycle \
			"$reason"

		recovery_level=3

		;;

	*)

		current="$(now)"

		if [ $((current - last_modem_reset)) \
			-ge "$MODEM_RESET_COOLDOWN" ]; then

			reset_modem \
				"$reason"

			last_modem_reset="$current"

			recovery_level=4

		else

			remaining=$((\
				MODEM_RESET_COOLDOWN - (\
				current - last_modem_reset)))

			log_warning \
				"modem reset suppressed by cooldown reason=$reason remaining=${remaining}s"

		fi

		;;

	esac

	bad_count=0

	sleep "$ACTION_GRACE"
}

###############################################################################
# Configuration sanity checks
###############################################################################

check_openwrt_config() {
	local force_connection
	local disable_modem

	force_connection="$(
		uci -q get \
			network.${NETIF}.force_connection
	)"

	disable_modem="$(
		uci -q get \
			network.${NETIF}.disable_modem
	)"

	if [ "$force_connection" != "1" ]; then

		log_warning \
			"network.$NETIF.force_connection is not 1"

	fi

	if [ "$disable_modem" != "0" ]; then

		log_warning \
			"network.$NETIF.disable_modem is not 0; soft reconnect may disable the modem radio"

	fi
}

###############################################################################
# Startup
###############################################################################

check_openwrt_config

log \
	"started interface=$NETIF api=$API_URL"

if [ "$REPORT_STARTUP" -eq 1 ]; then

	report_event \
		"info" \
		"watchdog-started" \
		"service-started" \
		"none"

fi

###############################################################################
# Main watchdog loop
###############################################################################

while :; do

	current="$(now)"

	modem_status="$(
		get_modem_status
	)"

	#######################################################################
	# ModemManager completely unavailable
	#######################################################################

	if [ -z "$modem_status" ]; then

		mm_failure_count=$((\
			mm_failure_count + 1))

		log \
			"mmcli unavailable count=$mm_failure_count"

		if [ "$mm_failure_count" -ge 3 ]; then

			ensure_incident

			if [ $((current - last_mm_restart)) \
				-ge "$MM_RESTART_COOLDOWN" ]; then

				restart_modemmanager \
					"modemmanager-unresponsive"

				last_mm_restart="$current"

				set_recovery_level_min 2

				sleep "$ACTION_GRACE"

			else

				remaining=$((\
					MM_RESTART_COOLDOWN - (\
					current - last_mm_restart)))

				log_warning \
					"ModemManager restart suppressed by cooldown remaining=${remaining}s"

			fi

			mm_failure_count=0

		fi

		sleep "$CHECK_INTERVAL"

		continue

	fi

	mm_failure_count=0

	#######################################################################
	# Extract state
	#######################################################################

	state="$(
		modemmanager_get_field \
			"$modem_status" \
			"modem.generic.state"
	)"

	registration="$(
		modemmanager_get_field \
			"$modem_status" \
			"modem.3gpp.registration-state"
	)"

	signal="$(
		modemmanager_get_field \
			"$modem_status" \
			"modem.generic.signal-quality.value"
	)"

	[ -n "$state" ] ||
		state="unknown"

	[ -n "$registration" ] ||
		registration="unknown"

	[ -n "$signal" ] ||
		signal="unknown"

	#######################################################################
	# Detect modem state transition
	#######################################################################

	if [ "$state" != "$last_state" ]; then

		log \
			"state ${last_state:-none} -> $state registration=$registration signal=$signal recovery_level=$recovery_level"

		last_state="$state"

		state_since="$current"

		bad_count=0

	fi

	state_age=$((\
		current - state_since))

	#######################################################################
	# State machine
	#######################################################################

	case "$state" in

	################################################################
	# Modem claims data connection exists.
	################################################################

	connected)

		bearer_path="$(
			get_bearer_path \
				"$modem_status"
		)"

		bearer_status="$(
			get_bearer_status \
				"$bearer_path"
		)"

		bearer_iface="$(
			get_bearer_iface \
				"$bearer_status"
		)"

		if internet_ok "$bearer_iface"; then
			log \
				"Internet is Connected iface=${bearer_iface:-none} recovery_level=$recovery_level"
			################################################
			# Connection successfully recovered.
			################################################
			if [ "$bad_count" -gt 0 ] ||
				[ "$recovery_level" -gt 0 ] ||
				[ -n "$incident_id" ]; then

				log \
					"Internet recovered iface=${bearer_iface:-none} incident=${incident_id:-none} recovery_level=$recovery_level"

				report_event \
					"info" \
					"internet-recovered" \
					"connectivity-restored" \
					"none"

			fi

			#
			# This is the ONLY normal place where
			# recovery escalation is cleared.
			#
			bad_count=0

			recovery_level=0

			clear_incident

		else

			bad_count=$((\
				bad_count + 1))

			log \
				"connected but Internet unavailable count=$bad_count iface=${bearer_iface:-none}"

			if [ "$bad_count" \
				-ge "$CONNECTED_FAIL_LIMIT" ]; then

				ensure_incident

				recover_connection \
					"connected-no-internet"

			fi

		fi

		;;

	################################################################
	# Cellular registration exists, but no data connection.
	################################################################

	registered)

		bad_count=$((\
			bad_count + 1))

		log \
			"registered without data count=$bad_count registration=$registration"

		if [ "$bad_count" \
			-ge "$REGISTERED_FAIL_LIMIT" ]; then

			ensure_incident

			recover_connection \
				"registered-without-data"

		fi

		;;

	################################################################
	# Searching is expected when train enters poor coverage.
	################################################################

	searching)

		bad_count=0

		if [ "$state_age" \
			-ge "$SEARCHING_RECOVERY_AFTER" ]; then

			if [ $((current - last_search_recovery)) \
				-ge "$SEARCHING_RECOVERY_COOLDOWN" ]; then

				ensure_incident

				log_recovery \
					"searching-too-long" \
					"searching-${state_age}-seconds" \
					"radio-cycle"

				radio_cycle \
					"searching-too-long"

				last_search_recovery="$current"

				set_recovery_level_min 3

				state_since="$(now)"

				sleep "$ACTION_GRACE"

			fi

		fi

		;;

	################################################################
	# Radio is enabled but registration hasn't started/progressed.
	################################################################

	enabled)

		bad_count=0

		if [ "$state_age" \
			-ge "$ENABLED_STATE_TIMEOUT" ]; then

			ensure_incident

			radio_cycle \
				"enabled-but-not-registering"

			set_recovery_level_min 3

			state_since="$(now)"

			sleep "$ACTION_GRACE"

		fi

		;;

	################################################################
	# Modem unexpectedly disabled.
	################################################################

	disabled)

		ensure_incident

		log_recovery \
			"modem-disabled" \
			"modem-unexpectedly-disabled" \
			"enable-modem"

		if ! mmcli \
			--timeout 60 \
			-m any \
			--enable \
			>/dev/null 2>&1; then

			log_error \
				"failed to enable unexpectedly disabled modem"

		else

			if ! ifup "$NETIF" \
				>/dev/null 2>&1; then

				log_error \
					"ifup failed after enabling modem"

			fi

		fi

		sleep "$ACTION_GRACE"

		;;

	################################################################
	# Temporary states.
	################################################################

	connecting | enabling | initializing | disconnecting | disabling)

		bad_count=0

		if [ "$state_age" \
			-ge "$TEMP_STATE_TIMEOUT" ]; then

			ensure_incident

			restart_modemmanager \
				"state-stuck-$state"

			last_mm_restart="$(now)"

			set_recovery_level_min 2

			state_since="$(now)"

			sleep "$ACTION_GRACE"

		fi

		;;

	################################################################
	# Never experiment automatically with SIM PIN/PUK.
	################################################################

	locked)

		bad_count=0

		log_warning \
			"modem locked; automatic recovery suppressed"

		sleep 30

		;;

	################################################################
	# ModemManager reports failed state.
	################################################################

	failed)

		reason="$(
			modemmanager_get_field \
				"$modem_status" \
				"modem.generic.state-failed-reason"
		)"

		[ -n "$reason" ] ||
			reason="unknown"

		ensure_incident

		case "$reason" in

		sim-missing | sim-error | sim-wrong)

			report_event \
				"error" \
				"modem-failed" \
				"$reason" \
				"automatic-reset-suppressed"

			log_warning \
				"modem failed reason=$reason; automatic reset suppressed"

			sleep 30

			;;

		*)

			recover_connection \
				"modem-failed-$reason"

			;;

		esac

		;;

	################################################################
	# Unexpected ModemManager state.
	################################################################

	*)

		bad_count=0

		log_warning \
			"unhandled modem state='$state'"

		sleep 10

		;;

	esac

	sleep "$CHECK_INTERVAL"

done
